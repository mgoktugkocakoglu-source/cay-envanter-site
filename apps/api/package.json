{
    "name": "@cayhesabim/api",
    "version": "0.0.1",
    "private": true,
    "description": "Çay Üreticisi Platformu - Backend API",
    "scripts": {
        "build": "nest build",
        "dev": "npx nest start --watch",
        "start": "nest start",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "format": "prettier --write \"src/**/*.ts\"",
        "typeorm": "node node_modules/typeorm/cli.js",
        "migration:generate": "npm run typeorm -- migration:generate -d dist/data-source.js",
        "migration:run": "npm run typeorm -- migration:run -d dist/data-source.js",
        "migration:revert": "npm run typeorm -- migration:revert -d dist/data-source.js"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.940.0",
        "@nestjs/common": "^10.3.0",
        "@nestjs/config": "^3.1.1",
        "@nestjs/core": "^10.3.0",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/passport": "^10.0.3",
        "@nestjs/platform-express": "^10.3.0",
        "@nestjs/swagger": "^7.2.0",
        "@nestjs/throttler": "^6.5.0",
        "@nestjs/typeorm": "^10.0.1",
        "bcrypt": "^5.1.1",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "helmet": "^7.1.0",
        "joi": "^17.12.0",
        "multer": "^2.0.2",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.11.3",
        "reflect-metadata": "^0.2.1",
        "resend": "^6.8.0",
        "rxjs": "^7.8.1",
        "typeorm": "^0.3.19",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.3.0",
        "@nestjs/schematics": "^10.1.0",
        "@types/bcrypt": "^5.0.2",
        "@types/express": "^4.17.21",
        "@types/multer": "^2.0.0",
        "@types/node": "^20.11.0",
        "@types/passport-jwt": "^4.0.1",
        "@types/uuid": "^9.0.7",
        "@typescript-eslint/eslint-plugin": "^6.19.0",
        "@typescript-eslint/parser": "^6.19.0",
        "eslint": "^8.56.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.3",
        "prettier": "^3.2.4",
        "typescript": "^5.3.3"
    }
}
