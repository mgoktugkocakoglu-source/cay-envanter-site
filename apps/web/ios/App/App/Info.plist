<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>

	<!-- Bundle Bilgileri -->
	<key>CFBundleDevelopmentRegion</key>
	<string>tr</string>
	<key>CFBundleDisplayName</key>
	<string>Çay Hesabım</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Cihaz Gereksinimleri (iOS 11+ tüm uygulamalar 64-bit zorunludur) -->
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>

	<!-- Şifreleme İhracat Uyumluluğu: Yalnızca HTTPS kullanıyoruz (muafiyet kapsamında) -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Ekran Yönleri -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- Görsel Ayarlar -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>

	<!-- Status bar yönetimi: View controller bazlı (Capacitor StatusBar plugin'i ile uyumlu) -->
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UIStatusBarHidden</key>
	<false/>

	<!-- iPad multitasking: tam ekran zorunluluğu yok (yan yana / slide-over destekli) -->
	<key>UIRequiresFullScreen</key>
	<false/>

	<!-- Web view'in Dynamic Type ile uyumu için -->
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Gizlilik İzinleri (App Store zorunluluğu) -->

	<!-- Konum: Leaflet harita için (alan konumu gösterimi) -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Çay tarlalarınızın konumunu haritada gösterebilmek için konum erişimine ihtiyaç duyulmaktadır.</string>

	<!-- Fotoğraf Kütüphanesi: Profil fotoğrafı ve topluluk gönderileri için -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Profil fotoğrafı yüklemek ve topluluk gönderilerine görsel eklemek için fotoğraf erişimine ihtiyaç duyulmaktadır.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Uygulama içi fotoğrafları fotoğraf kütüphanenize kaydetmek için erişim gerekmektedir.</string>

	<!-- Kamera: Profil ve topluluk için fotoğraf çekme -->
	<key>NSCameraUsageDescription</key>
	<string>Profil fotoğrafı çekmek veya topluluk gönderilerine anlık fotoğraf eklemek için kamera erişimine ihtiyaç duyulmaktadır.</string>

	<!-- Mikrofon: Video yükleme özelliği için -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Topluluk gönderilerine video eklerken ses kaydı yapabilmek için mikrofon erişimine ihtiyaç duyulmaktadır.</string>

	<!-- ATS (App Transport Security) - HTTPS zorlaması -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Desteklenen URL şemaları -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cayhesabim</string>
			</array>
			<key>CFBundleURLName</key>
			<string>com.cayhesabim.app</string>
		</dict>
	</array>

	<!-- Uygulama Kategorisi (App Store) -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.business</string>
</dict>
</plist>
