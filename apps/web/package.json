{
    "name": "@cayhesabim/web",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "description": "Çay Üreticisi Platformu - Frontend",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc -b && vite build",
        "build:mobile": "vue-tsc -b && vite build --mode mobile",
        "preview": "vite preview",
        "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
        "format": "prettier --write src/",
        "cap:sync": "npx cap sync",
        "cap:ios": "npx cap open ios",
        "cap:android": "npx cap open android",
        "cap:build:ios": "pnpm build:mobile && npx cap sync ios",
        "cap:build:android": "pnpm build:mobile && npx cap sync android",
        "generate:assets": "node scripts/generate-assets.mjs"
    },
    "dependencies": {
        "@capacitor-community/bluetooth-le": "^8.2.0",
        "@capacitor/android": "^8.3.1",
        "@capacitor/app": "^8.1.0",
        "@capacitor/core": "^8.3.1",
        "@capacitor/ios": "^8.3.1",
        "@capacitor/keyboard": "^8.0.3",
        "@capacitor/splash-screen": "^8.0.1",
        "@capacitor/status-bar": "^8.0.2",
        "@googlemaps/js-api-loader": "^2.1.1",
        "@lucide/vue": "^1.45.0",
        "@radix-icons/vue": "^1.0.0",
        "@tiptap/core": "^3.19.0",
        "@tiptap/extension-image": "^3.19.0",
        "@tiptap/extension-link": "^3.19.0",
        "@tiptap/extension-placeholder": "^3.19.0",
        "@tiptap/extension-youtube": "^3.19.0",
        "@tiptap/pm": "^3.19.0",
        "@tiptap/starter-kit": "^3.19.0",
        "@tiptap/vue-3": "^3.19.0",
        "@vueuse/core": "^14.4.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "leaflet": "^1.9.4",
        "pinia": "^2.1.7",
        "reka-ui": "^2.10.4",
        "tailwind-merge": "^3.6.0",
        "vue": "^3.4.15",
        "vue-router": "^4.2.5"
    },
    "devDependencies": {
        "@capacitor/cli": "^8.3.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/google.maps": "^3.66.2",
        "@types/leaflet": "^1.9.21",
        "@types/node": "^20.0.0",
        "@types/web-bluetooth": "^0.0.21",
        "@vitejs/plugin-vue": "^5.0.3",
        "@vue/eslint-config-typescript": "^12.0.0",
        "eslint": "^8.56.0",
        "eslint-plugin-vue": "^9.20.1",
        "prettier": "^3.2.4",
        "sharp": "^0.34.5",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "~5.3.3",
        "vite": "^5.0.11",
        "vue-tsc": "^1.8.27"
    }
