# Mobil (Capacitor) build ortamı
# Capacitor native build'de /api relative path çalışmaz, tam URL gereklidir
# Kendi API sunucunuzun URL'sini buraya yazın:
VITE_API_BASE_URL=https://cayhesabim.com/api

# Google Maps JavaScript API (Hassas ölçüm > Harita ile). Tarayıcı anahtarı; Cloud Consoleda HTTP yönlendiren kısıtlaması yapın.
VITE_GOOGLE_MAPS_API_KEY=
