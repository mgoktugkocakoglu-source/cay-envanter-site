# Production Environment Variables
# Copy this file to .env and fill in the values

# Database
DB_USERNAME=postgres
DB_PASSWORD=your-secure-password
DB_DATABASE=cayhesabim

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-characters
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-characters
JWT_REFRESH_EXPIRES_IN=7d

# Resend (email)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=Çay Üreticisi Platformu <noreply@cayhesabim.com>

# Application
APP_URL=https://your-domain.com

# Cloudflare R2 uploads
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name
R2_PUBLIC_URL=https://cdn.your-domain.com
R2_PREFIX=cayhesabim

# AI agent (Google Gemini). Optional: leave blank to run the
# knowledge base in retrieval-only mode (no generated answers).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Google Maps JavaScript API browser key for the web build (pruning measurement map).
# Restricted by HTTP referrer in Google Cloud console; passed to the web image as a build arg.
VITE_GOOGLE_MAPS_API_KEY=
